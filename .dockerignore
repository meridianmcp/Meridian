.env
meridian.toml
.pixi/
data/
__pycache__/
*.pyc
.venv/
*.sqlite3
tmp/
logs/

# Not needed in the container
.git/
.github/
.claude/
docs/
tests/
# extensions/* (not "extensions/") + explicit negation below: `dir/` excludes
# the directory itself and Docker will NEVER re-include children of a
# directory-level exclusion, but `dir/*` excludes each entry individually,
# which a `!` pattern for one specific entry CAN still override.
# meridian-codeindex must ship in the main image (imported directly by
# meridian/code_index.py, see Dockerfile) -- the other extensions run as
# their own separate `uvx`-launched subprocesses and don't need to be here.
extensions/*
!extensions/meridian-codeindex
!extensions/meridian-codeindex/**
# c11c5117 -- packages/ is deliberately NOT excluded: the Dockerfile installs
# ./packages/docparse (meridian/docs_intel.py + latex_intel.py import it), and
# `uv pip install` needs its pyproject.toml, README.md and docparse/ package dir
# present in the build context. Do not add a `packages/` (or `packages/*`) line
# here without a matching `!packages/docparse` + `!packages/docparse/**` pair;
# tests/test_c11c5117_dockerfile_docparse.py pins this.
npm/
# scripts/* (not "scripts/") + explicit negation below: same directory-vs-entry
# exclusion distinction as extensions/* above. meridian/routes/hooks.py serves
# these specific scripts to installer clients by reading them from disk at
# request time (_watcher_script_path: <repo_root>/scripts/<filename>), so they
# must survive into the image; the rest of scripts/ (dev/release tooling) does
# not need to ship and stays excluded.
scripts/*
!scripts/install-windows.ps1
!scripts/install_tunnel.sh
!scripts/install_tunnel.ps1
!scripts/install_watcher.sh
!scripts/install_watcher.ps1
!scripts/hooks_install.ps1
site/
*.spec
*.bat
*.log

# Dev tools
.ruff_cache/
.pytest_cache/
.mypy_cache/
node_modules/
