                        "command": "& \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\sprint_guard.ps1\""
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"C:\\Users\\13144\\.claude\\hooks\\meridian-start.ps1\""
                    }
                ]
            },
            {
                "matcher": "compact",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\post_compact_refresh.ps1\""
                    }
                ]
            }
