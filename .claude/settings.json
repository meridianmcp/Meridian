{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "mcp__.*__register_session_recovery",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\session_recovery_hook.py\"; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1",
                        "timeout": 10
                    }
                ]
            },
            {
                "matcher": "AskUserQuestion",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\hitl_guard.ps1\"; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1"
                    }
                ]
            },
            {
                "matcher": "Edit|Write|MultiEdit|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\worktree_guard.ps1\"; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1"
                    }
                ]
            },
            {
                "matcher": "Read|Bash|PowerShell|Grep|Glob|Write|Edit|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\secret_guard.ps1\"; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1"
                    }
                ]
            },
            {
                "matcher": "Bash|PowerShell",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\dependency_install_guard.ps1\"; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1"
                    }
                ]
            },
            {
                "matcher": "Bash|PowerShell",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\pkg_install_guard.ps1\"; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1"
                    }
                ]
            },
            {
                "matcher": "Grep|Glob|Bash|PowerShell|Monitor|Write|Edit|MultiEdit|NotebookEdit|WebSearch|WebFetch|mcp__dc__.*|mcp__codebase-memory(-mcp)?__(search_graph|search_code|trace_path|get_code_snippet|query_graph|get_architecture)|mcp__.*__patch_file|mcp__.*__(write_memory|edit_memory|rename_memory)",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\meridian_guard.ps1\"; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1",
                        "timeout": 3
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "mcp__.*__get_session_recovery",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\session_recovery_hook.py\"; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1",
                        "timeout": 10
                    }
                ]
            },
            {
                "matcher": "mcp__.*__complete_sprint_item",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\post_compact_refresh.ps1\" -Event post_complete; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1"
                    }
                ]
            },
            {
                "matcher": "Edit|Write|MultiEdit|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\test_tamper_guard.ps1\"; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1"
                    }
                ]
            },
            {
                "matcher": "Edit|Write|MultiEdit|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\artifact_capture_hook.py\"; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1",
                        "timeout": 10
                    }
                ]
            },
            {
                "matcher": "WebSearch|WebFetch|mcp__codebase-memory(-mcp)?__.*|mcp__serena__find.*|mcp__.*__(paper_search|github_search|start_session|capture_research_finding|add_note|search_code|prospect_symbol|load_handoff|get_sprint_items|get_session_brief|refresh_context|get_agent_instructions|claim_sprint_item)",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\meridian_guard_post.ps1\"; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1",
                        "timeout": 3
                    }
                ]
            }
        ],
        "Stop": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\post_compact_refresh.ps1\" -Event stop; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1"
                    }
                ]
            },
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\sprint_guard.ps1\"; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1"
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "startup|resume",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\post_compact_refresh.ps1\" -Event startup; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1"
                    }
                ]
            },
            {
                "matcher": "compact",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\post_compact_refresh.ps1\" -Event compact; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1"
                    }
                ]
            },
            {
                "matcher": "startup|resume|clear|compact",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\meridian_guard_brief.ps1\"; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1",
                        "timeout": 10
                    }
                ]
            },
            {
                "matcher": "startup|resume|clear|compact",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\tunnel_health_check.ps1\"; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1",
                        "timeout": 3
                    }
                ]
            }
        ],
        "PreCompact": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\post_compact_refresh.ps1\" -Event pre_compact; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1"
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\post_compact_refresh.ps1\" -Event user_prompt_submit; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1"
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\post_compact_refresh.ps1\" -Event session_end; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1"
                    }
                ]
            }
        ],
        "SubagentStart": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\meridian_guard_brief.ps1\"; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1",
                        "timeout": 10
                    },
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\session_recovery_hook.py\"; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1",
                        "timeout": 10
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\session_recovery_hook.py\"; if ($?) { exit 0 }; if ($LASTEXITCODE) { exit $LASTEXITCODE }; exit 1",
                        "timeout": 10
                    }
                ]
            }
        ]
    },
    "permissions": {
        "allow": [
            "Bash(*)",
            "Read(*)",
            "Write(*)",
            "Edit(*)",
            "WebFetch(*)",
            "WebSearch(*)"
        ]
    }
}
