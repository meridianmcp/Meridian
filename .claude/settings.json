{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "AskUserQuestion",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\hitl_guard.ps1\""
                    }
                ]
            },
            {
                "matcher": "Edit|Write|MultiEdit|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\worktree_guard.ps1\""
                    }
                ]
            },
            {
                "matcher": "Read|Bash|PowerShell|Grep|Glob",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\secret_guard.ps1\""
                    }
                ]
            },
            {
                "matcher": "Bash|PowerShell",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\dependency_install_guard.ps1\""
                    }
                ]
            },
            {
                "matcher": "Bash|PowerShell",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\pkg_install_guard.ps1\""
                    }
                ]
            },
            {
                "matcher": "Grep|Glob|Bash|PowerShell|Monitor|Write|Edit|MultiEdit|NotebookEdit|WebSearch|WebFetch|mcp__dc__.*|mcp__codebase-memory(-mcp)?__(search_graph|search_code|trace_path|get_code_snippet|query_graph|get_architecture)|mcp__.*__patch_file|mcp__.*__(write_memory|edit_memory|rename_memory)",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\meridian_guard.ps1\"",
                        "timeout": 3
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\test_tamper_guard.ps1\""
                    }
                ]
            },
            {
                "matcher": "WebSearch|WebFetch|mcp__codebase-memory(-mcp)?__.*|mcp__serena__find.*|mcp__.*__(paper_search|github_search|start_session|capture_research_finding|add_note|search_code|prospect_symbol|load_handoff|get_sprint_items|get_session_brief|refresh_context|get_agent_instructions|claim_sprint_item)",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\meridian_guard_post.ps1\"",
                        "timeout": 3
                    }
                ]
            }
        ],
        "Stop": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\sprint_guard.ps1\""
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "compact",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\post_compact_refresh.ps1\""
                    }
                ]
            },
            {
                "matcher": "startup|resume|clear|compact",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\meridian_guard_brief.ps1\"",
                        "timeout": 10
                    }
                ]
            }
        ],
        "SubagentStart": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "shell": "powershell",
                        "command": "& \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\meridian_guard_brief.ps1\"",
                        "timeout": 10
                    }
                ]
            }
        ]
    },
    "permissions": {
        "allow": [
            "Bash(*)",
            "Read(*)",
            "Write(*)",
            "Edit(*)",
            "WebFetch(*)",
            "WebSearch(*)"
        ]
    }
}
