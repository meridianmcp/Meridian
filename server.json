{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ajc3xc/meridian",
  "description": "Persistent memory, task coordination, and HITL queue for AI coding sessions.",
  "repository": {
    "url": "https://github.com/meridianmcp/Meridian",
    "source": "github"
  },
  "version": "0.1.0-pre-alpha",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@meridianmcp/mcp",
      "version": "0.1.0-pre-alpha",
      "transport": { "type": "stdio" }
    },
    {
      "registryType": "pypi",
      "identifier": "meridian-server",
      "version": "0.1.0.dev1",
      "transport": { "type": "stdio" }
    }
  ],
  "remotes": [
    {
      "type": "sse",
      "url": "https://usemeridian.us/mcp/sse",
      "headers": [
        {
          "name": "Authorization",
          "description": "Required. 'Bearer sk_meridian_...' with an API token from https://usemeridian.us/dashboard (or an OAuth access token; the 401 advertises the authorization server).",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
