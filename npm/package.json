    "type": "git",
    "url": "https://github.com/meridianmcp/Meridian.git"
  },
  "license": "MSL-1.0",
  "type": "module",
  "bin": {
    "meridian-mcp": "./bin/meridian-mcp.cjs",
    "meridian-latex": "./latex/cli.js"
  },
  "exports": {
    "./latex": "./latex/index.js"
  },
  "engines": { "node": ">=22" },
  "files": ["bin/", "latex/", "README.md"],
