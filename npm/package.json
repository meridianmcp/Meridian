    "@modelcontextprotocol/sdk": "^1.30.0",
    "@unified-latex/unified-latex-types": "^1.8.4",
    "@unified-latex/unified-latex-util-parse": "^1.8.4",
    "better-sqlite3": "^13.0.3",
    "chrome-launcher": "^1.2.1",
    "chrome-remote-interface": "^0.34.0",
    "ws": "^8.21.3"
  }
