# .env.local — local overrides for development
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit it.
# These values override .env when running locally.

# Leave blank to use local SQLite (data/meridian.db) instead of the real auth DB.
# Set to a Postgres URL to test against a real DB (use a dev/test Neon branch, not production).
MERIDIAN_AUTH_DB=

# Stripe test keys — use sk_test_... and whsec_test_...
# The real production keys are in .env (never committed).
STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here

# Leave blank to use in-memory SQLite for the demo (seeded on startup).
# Set to a Postgres URL to test with a persistent demo DB.
MERIDIAN_DEMO_DB_URL=

# Set to 1 to skip demo DB init entirely (speeds up local startup).
MERIDIAN_SKIP_DEMO=0

# Override the server URL for local testing (default: http://localhost:7878).
MERIDIAN_SERVER_URL=http://localhost:7878

# Set to a test Resend API key to test email sending locally.
# Leave blank to skip email sends during local dev.
RESEND_API_KEY=

# Session cookie secret — any random string for local dev.
MERIDIAN_SESSION_SECRET=dev-local-secret-change-me

# Admin emails for local dev — comma-separated.
MERIDIAN_ADMIN_EMAILS=your@email.com
