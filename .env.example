# Meridian environment configuration
# Copy this file to .env and fill in your values
# .env is gitignored — never commit it

# Database backend
# Leave commented out to use local SQLite (default)
# Set to a Postgres connection string to use hosted Postgres
# MERIDIAN_DB_URL=postgres://user:password@host/dbname?sslmode=require

# Server config (optional overrides)
# MERIDIAN_PORT=7878
# MERIDIAN_HOST=127.0.0.1
