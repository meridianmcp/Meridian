# Meridian environment configuration
# Copy this file to .env and fill in your values
# .env is gitignored — never commit it

# ── Database backend ───────────────────────────────────────────────────────
# Leave commented out to use local SQLite (default, zero config)
# Set to a Postgres connection string to use hosted Postgres (Neon, Supabase…)
# MERIDIAN_DB_URL=postgresql://user:password@host/dbname?sslmode=require

# For running the test suite against a real Postgres instance:
# TEST_DATABASE_URL=postgresql://user:password@host/testdb?sslmode=require

# ── Identity ───────────────────────────────────────────────────────────────
# Your name / handle — shown on tasks you claim in the dashboard.
# Auto-detected from USER / USERNAME / hostname when not set.
# MERIDIAN_HUMAN_ID=adam

# ── Server config ──────────────────────────────────────────────────────────
# MERIDIAN_PORT=7878
# MERIDIAN_HOST=127.0.0.1
